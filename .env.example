# VoxCampus environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values. Every variable is
# optional — the app boots with the checked-in defaults and falls back to the
# built-in demo workspace when a backend cannot be reached.

# --- Firebase (auth + Firestore) ------------------------------------------
# Firebase Console → Project settings → Your apps → SDK setup and config.
# These values are public by design; access is controlled by Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary (podcast / material / avatar uploads) ----------------------
# Create an *unsigned* upload preset and put its name here.
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=

# --- AI assistant ----------------------------------------------------------
# Server-side only: this key is read by the serverless function in `api/ai.js`
# and is deliberately NOT prefixed with VITE_. Anything prefixed VITE_ is
# inlined into the client bundle and becomes public.
# Set this in your host's dashboard (Vercel → Settings → Environment Variables).
OPENCODE_API_KEY=

# --- ZegoCloud (live audio rooms) ------------------------------------------
# Zego console → Project management → your project. The server secret can mint
# tokens for any room on the account, so keep it out of shared repositories.
VITE_ZEGO_APP_ID=
VITE_ZEGO_SERVER_SECRET=
